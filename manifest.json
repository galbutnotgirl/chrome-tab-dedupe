{
  "manifest_version": 3,
  "name": "Tab Dedupe",
  "version": "1.5.0",
  "description": "Opens the tab you already have instead of a second copy \u2014 and moves it next to the tab you're on.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "sessions"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Dedupe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "description": "Open Tab Dedupe"
    },
    "sweep-now": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Close duplicate tabs immediately (no popup)"
    },
    "bypass-next": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Next tab opens as a new copy (skip dedupe)"
    }
  }
}
